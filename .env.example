# Copy to .env for local Supabase-connected runs, or set these in
# Vercel → Project → Settings → Environment Variables for production.

SUPABASE_URL=<your-supabase-project-url>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>  # SECRET — server-side only

SESSION_SECRET=<generate-a-long-random-string>    # e.g. openssl rand -hex 32

# NEONMONKI AI (Kimi / Moonshot) — server-side only, never sent to the browser.
# Get a key from the Kimi/Moonshot platform used by your account.
KIMI_API_KEY=<your-kimi-api-key>
# KIMI_BASE_URL=https://api.moonshot.ai/v1        # override for the China platform or a mock

# Initial bootstrap credentials. Use strong, unique production values.
ADMIN_PASSWORD=<your-super-admin-password>
ADIKA_PASSWORD=<your-client-password>
TEAM_PASSWORD=<your-team-password>

# PORT=4173                                        # local dev only
