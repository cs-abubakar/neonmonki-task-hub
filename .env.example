# Copy to .env for local Supabase-connected runs, or set these in
# Vercel → Project → Settings → Environment Variables for production.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET — server-side only, never in the browser

SESSION_SECRET=any-long-random-string             # signs the login cookie

# NEONMONKI AI (Kimi / Moonshot) — server-side only, never sent to the browser.
# Get a key at platform.kimi.ai (international) — platform.kimi.com keys are separate.
KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/v1        # override for the China platform or a mock

# Login credentials (defaults shown — change before sharing the link!)
ADMIN_PASSWORD=NM-admin-2026                      # super admin (abubakar)
ADIKA_PASSWORD=neonmonki2026
TEAM_PASSWORD=advertidea2026

